+def volume_notes(spec):
+    """Listing only, like the rest: no volume block, or a volume figure outside it."""
+    text = json.dumps(spec, ensure_ascii=False)
+    notes = []
+    if '"type": "volume"' not in text and '"type":"volume"' not in text:
+        notes.append("volume: this report has no volume block (guide section 4)")
+    figure = re.compile(r"[^.<>\"]*\bvolume\b[^.<>\"]*\b\d[\d.,]*\s*(?:times|%|percent)[^.<>\"]*|"
+                        r"[^.<>\"]*\b\d[\d.,]*\s*(?:times|%|percent)[^.<>\"]*\bvolume\b[^.<>\"]*",
+                        re.IGNORECASE)
+    for hit in figure.findall(text):
+        notes.append("volume: a volume figure outside the block: " + hit.strip()[:120])
+    return notes
+
