+VOLUME_MISSING = "Volume figures are not available for this report."
+VOLUME_STALE = "Volume figures are not current, so they are not read in this report."
+# The view is rewritten every five minutes in the session and otherwise once a phase,
+# so an old one in the session means its publisher has stopped.
+VOLUME_MAX_AGE_MIN = 15
+_volume_lines = None    # set by build() for the spec being rendered
+
+
+def volume_lines(spec):
+    """The market service's volume sentences for this spec's slot, read from the newest
+    snapshot, so the model cannot reword them. Absent or old reads as that, never as a
+    quiet market."""
+    data = pathlib.Path(__file__).resolve().parent.parent / str(spec.get("date")) / "data"
+    snaps = sorted(data.glob(f"{spec.get('slot')}-*.json"), key=lambda p: p.stat().st_mtime)
+    if not snaps:
+        return [VOLUME_MISSING]
+    try:
+        snap = json.loads(snaps[-1].read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return [VOLUME_MISSING]
+    view = snap.get("volume") if isinstance(snap, dict) else None
+    payload = view.get("payload") if isinstance(view, dict) else None
+    if not isinstance(payload, dict) or not payload.get("statements"):
+        return [VOLUME_MISSING]
+    today = (snap.get("calendar") or {}).get("today")
+    age = view.get("age_min")
+    if payload.get("date") != today or (
+            payload.get("phase") == "session"
+            and (not isinstance(age, (int, float)) or age > VOLUME_MAX_AGE_MIN)):
+        return [VOLUME_STALE]
+    return [str(line) for line in payload["statements"]]
+
+
+def b_volume(b):
+    """No text of its own: see volume_lines."""
+    lines = _volume_lines if _volume_lines is not None else [VOLUME_MISSING]
+    return "<ul>" + "".join(f"<li>{esc(line)}</li>" for line in lines) + "</ul>"
+
+
