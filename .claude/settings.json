{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard_secrets.py\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard_prod_promote.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/ruff_fix.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python -m pytest *)",
      "Bash(../.venv/Scripts/python -m pytest *)",
      "Bash(./.venv/Scripts/python.exe -m pytest *)",
      "Bash(../.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python -m ruff *)",
      "Bash(.venv/Scripts/python.exe -m ruff *)",
      "Bash(D:/WebGUI Trading with Schwab/.venv/Scripts/python.exe -m pytest *)",
      "Bash(D:/WebGUI Trading with Schwab/.venv/Scripts/python.exe -m ruff *)",
      "Bash(\"D:/WebGUI Trading with Schwab/.venv/Scripts/python.exe\" -m pytest *)",
      "Bash(\"D:/WebGUI Trading with Schwab/.venv/Scripts/python.exe\" -m ruff *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(../.venv/bin/python -m pytest *)",
      "Bash(./.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/python -m ruff *)",
      "Bash(../.venv/bin/python -m ruff *)",
      "Bash(/home/administrator/prod/.venv/bin/python -m pytest *)",
      "Bash(/home/administrator/prod/.venv/bin/python -m ruff *)",
      "Bash(/home/administrator/dev/.venv/bin/python -m pytest *)",
      "Bash(/home/administrator/dev/.venv/bin/python -m ruff *)",
      "Bash(systemctl --user *)",
      "Bash(journalctl --user *)"
    ]
  }
}
